---
// Algemene voorwaarden. De tekst is van Sander (eigen voorwaarden, geen NLdigital) en staat in
// src/i18n/legal/voorwaarden.nl.md (artikelen als ##, datum en versie in de frontmatter).
import LegalLayout from '../layouts/LegalLayout.astro';
import { t } from '../i18n';
import { Content, frontmatter } from '../i18n/legal/voorwaarden.nl.md';

const locale = 'nl';
const d = t(locale).legal.terms;
---

<LegalLayout
  metaTitle={d.metaTitle}
  description={d.metaDescription}
  title={d.title}
  updated={frontmatter.updated}
  version={frontmatter.version}
  locale={locale}
>
  <Content />
</LegalLayout>
