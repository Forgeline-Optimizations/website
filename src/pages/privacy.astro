---
// Privacyverklaring. De tekst is van Sander en staat in src/i18n/legal/privacy.nl.md (koppen vanaf ##,
// datum in de frontmatter). tests/unit/legal.test.ts bewaakt dat de bedrijfsgegevens erin gelijk zijn aan site.ts.
import LegalLayout from '../layouts/LegalLayout.astro';
import { t } from '../i18n';
import { Content, frontmatter } from '../i18n/legal/privacy.nl.md';

const locale = 'nl';
const d = t(locale).legal.privacy;
---

<LegalLayout
  metaTitle={d.metaTitle}
  description={d.metaDescription}
  title={d.title}
  updated={frontmatter.updated}
  locale={locale}
>
  <Content />
</LegalLayout>
