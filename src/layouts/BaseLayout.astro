---
import '../styles/global.css';
import saira700 from '@fontsource/saira/files/saira-latin-700-normal.woff2?url';
import SkipLink from '../components/site/SkipLink.astro';
import NavBar from '../components/site/NavBar.astro';
import Footer from '../components/site/Footer.astro';
import MotionLoader from '../components/site/MotionLoader.astro';
import Analytics from '../components/site/Analytics.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  noindex?: boolean;
  ogImage?: string;
  showChapters?: boolean;
  motion?: boolean; // laadt src/scripts/motion lazy na `load` (alleen `/`)
}

const {
  title,
  description,
  locale = 'nl',
  noindex = false,
  ogImage = '/og-image.png',
  showChapters = false,
  motion = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const ogLocale = locale === 'nl' ? 'nl_NL' : 'en_GB';
// Alleen in de echte build: `astro dev` telt geen bezoeken.
const analytics = import.meta.env.PROD && Boolean(site.plausibleScriptSrc);
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Het 700-gewicht draagt de hero-kop; vooraf laden voorkomt een zichtbare fontwissel. -->
    <link rel="preload" href={saira700} as="font" type="font/woff2" crossorigin />
    {analytics && <Analytics />}
  </head>
  <body data-theme="dark">
    <SkipLink locale={locale} />
    <NavBar locale={locale} showChapters={showChapters} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    {motion && <MotionLoader />}
  </body>
</html>
