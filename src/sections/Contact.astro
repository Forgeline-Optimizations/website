---
// 08 · Contact (licht) — design/storyboard/Contact.dc.html. Zonder JS: gewone POST naar Web3Forms met
// browservalidatie en redirect (ADR-003). Met JS: src/scripts/contact-form.ts zet `novalidate`, valideert in het
// Nederlands en verstuurt via fetch.
import Chapter from '../components/site/Chapter.astro';
import Button from '../components/ui/Button.astro';
import Field from '../components/ui/Field.astro';
import Icon from '../components/ui/Icon.astro';
import NextSteps from '../components/site/NextSteps.astro';
import ForgeLine from '../components/site/ForgeLine.astro';
import { t, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale?: Locale;
}

const { locale = 'nl' } = Astro.props;
const d = t(locale).contact;
const f = d.fields;
const fromName = new URL(site.url).hostname;
const messages = JSON.stringify({ ...d.errors, sending: d.sending });
---

<Chapter id="contact" num="08" theme="light" kicker={d.kicker} title={d.title} lead={d.lead} end>
  <div class="chapter__visual contact" data-motion="contact">
    <form
      class="fl-form"
      action="https://api.web3forms.com/submit"
      method="POST"
      data-contact-form
      data-messages={messages}
    >
      <input type="hidden" name="access_key" value={site.web3formsAccessKey} />
      <input type="hidden" name="redirect" value={site.formRedirect} />
      <input type="hidden" name="subject" value={d.subject} />
      <input type="hidden" name="from_name" value={fromName} />
      <!-- Honeypot: verborgen voor mensen; Web3Forms negeert inzendingen waarin hij aangevinkt is. -->
      <div class="fl-honeypot" aria-hidden="true">
        <label>
          {f.honeypot} <input type="checkbox" name="botcheck" tabindex="-1" />
        </label>
      </div>

      <Field id="contact-name" name="name" label={f.name} autocomplete="name" required />
      <Field id="contact-company" name="company" label={f.company} autocomplete="organization" />
      <Field id="contact-email" name="email" type="email" label={f.email} autocomplete="email" required />
      <Field
        id="contact-phone"
        name="phone"
        type="tel"
        label={f.phone}
        optionalLabel={f.optional}
        autocomplete="tel"
      />
      <Field
        id="contact-message"
        name="message"
        label={f.message}
        placeholder={f.messagePlaceholder}
        textarea
        required
        full
      />
      <div class="fl-field fl-form__full" data-field="privacy">
        <label class="fl-check">
          <input type="checkbox" id="contact-privacy" name="privacy" required />
          <!-- prettier-ignore: geen witruimte tussen de delen, anders staat er een spatie vóór de punt -->
          <!-- prettier-ignore -->
          <span>{d.privacy.before}<a href="/privacy">{d.privacy.linkText}</a>{d.privacy.after}</span>
        </label>
        <p class="fl-field__msg" id="contact-privacy-error" data-error hidden>
          <Icon name="alert" />
          <span></span>
        </p>
      </div>
      <div class="fl-form__full contact__submit">
        <ForgeLine part="end" locale={locale} />
        <Button variant="primary" type="submit" arrow data-forge-anchor="end">
          {d.submit}
        </Button>
      </div>
      <p class="fl-field__msg fl-form__full" data-form-status role="alert" hidden>
        <Icon name="alert" />
        <span></span>
      </p>
    </form>

    <NextSteps locale={locale} id="contact-next" />
  </div>
</Chapter>

<script>
  import '../scripts/contact-form';
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-12);
  }
  .contact__submit {
    position: relative;
  }
  .contact .fl-form {
    max-width: none;
  }
  @media (min-width: 1200px) {
    .contact {
      grid-template-columns: minmax(0, 680px) 320px;
      justify-content: space-between;
      align-items: start;
    }
  }
</style>
