---
// 05 · Eerlijk oordeel — design/storyboard/Oordeel.dc.html en MobielOordeel.dc.html.
// Statisch: zonder JS staan alle vijf panelen onder elkaar; fase 3 voegt het wisselen toe.
import Chapter from '../components/site/Chapter.astro';
import Badge from '../components/ui/Badge.astro';
import { t, type Locale } from '../i18n';
import { verdicts, verdictsMobile, defaultVerdict } from '../data/verdicts';

interface Props {
  locale?: Locale;
}

const { locale = 'nl' } = Astro.props;
const d = t(locale).oordeel;
---

<Chapter id="oordeel" num="05" theme="dark" kicker={d.kicker} title={d.title} lead={d.lead}>
  <div class="chapter__visual verdict">
    <p class="fl-tag verdict__example">{d.exampleLabel}</p>
    <div class="fl-verdict" data-verdict-root data-motion="oordeel">
      <ul class="fl-verdict__steps" aria-label={d.stepsLabel}>
        {verdicts.map((v, i) => (
          <li class:list={{ 'hidden desk:block': !verdictsMobile.includes(v.id) }}>
            <button
              type="button"
              class="fl-verdict__step"
              data-verdict-step={v.id}
              aria-pressed={v.id === defaultVerdict ? 'true' : 'false'}
              aria-controls={`verdict-${v.id}`}
            >
              <span class="fl-verdict__long">{d.items[v.id].title}</span>
              <span class="fl-verdict__short">{d.items[v.id].shortTitle}</span>
              <span class="fl-label">{String(i + 1).padStart(2, '0')}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="fl-verdict__panels">
        {verdicts.map((v) => (
          <div
            class="fl-verdict__panel"
            id={`verdict-${v.id}`}
            data-verdict-panel={v.id}
            data-active={v.id === defaultVerdict ? '' : undefined}
          >
            <p class="fl-verdict__meta">{d.items[v.id].meta}</p>
            <h3 class="fl-verdict__title">{d.items[v.id].title}</h3>
            <Badge verdict={v.verdict} label={d.verdictLabels[v.verdict]} />
            <p class="fl-verdict__reason">{d.items[v.id].reason}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Chapter>

<style>
  .verdict__example {
    margin: 0 0 var(--space-4);
  }
</style>
