---
// 04 · Over mij — design/storyboard/OverMij.dc.html.
import { Image } from 'astro:assets';
import Chapter from '../components/site/Chapter.astro';
import Button from '../components/ui/Button.astro';
import { t, type Locale } from '../i18n';
import { site } from '../data/site';
import portrait from '../assets/images/sander-portrait-tijdelijk.jpg';

interface Props {
  locale?: Locale;
}

const { locale = 'nl' } = Astro.props;
const d = t(locale).overMij;
---

<Chapter id="over-mij" num="04" theme="dark" kicker={d.kicker} title={d.title}>
  <div class="chapter__visual fl-profile" data-motion="over-mij">
    <div class="fl-profile__photo">
      <Image src={portrait} alt={d.photoAlt} widths={[320, 640]} sizes="(min-width: 1200px) 320px, 280px" />
    </div>
    <div>
      <h3 class="fl-profile__name">{d.name}</h3>
      <p class="fl-profile__role fl-label">{d.role}</p>
      <p class="fl-profile__text">{d.p1}</p>
      <p class="fl-profile__text">{d.p2}</p>
      <Button variant="link" href={`mailto:${site.personalEmail}`}>
        {site.personalEmail}
      </Button>
      <ul class="fl-profile__facts">
        {d.facts.map((f) => (
          <li>
            <span class="fl-label">{f.label}</span>
            <span>{f.value}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Chapter>
