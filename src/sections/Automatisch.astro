---
// 04 · Automatiseren — design/storyboard/Automatisch.dc.html. Het voorbeeldlabel is verplicht (SOUL).
import Chapter from '../components/site/Chapter.astro';
import ProcessNode from '../components/ui/ProcessNode.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'nl' } = Astro.props;
const d = t(locale).automatisch;
// "25 → 4 min" → oud en nieuw apart, zodat de beweging eerst alleen de oude waarde kan tonen.
const split = (result: string) => {
  const [before, after] = result.split(' → ');
  return after === undefined ? null : { before, after };
};
---

<Chapter id="automatisch" num="04" theme="dark" kicker={d.kicker} title={d.title} lead={d.lead}>
  <div class="chapter__visual auto" data-motion="automatisch">
    <p class="fl-tag auto__example">{d.exampleLabel}</p>
    <div class="auto__track">
      <!-- De verlichte lijn met de stroom loopt achter de nodes langs en eindigt in een oranje vierkant. -->
      <span class="auto__line" aria-hidden="true">
        <span class="auto__flow"></span>
        <span class="auto__end"></span>
      </span>
      <ol class="auto__steps">
        {d.steps.map((step) => (
          <li class="auto__step">
            <ProcessNode
              class="auto__node"
              state={step.automated ? 'automated' : 'standard'}
              index={step.index}
              name={step.name}
              port
            />
            {split(step.result) ? (
              <span class="fl-chip auto__result">
                <span data-old>{split(step.result)!.before}</span>
                <span data-arrow>→</span>
                <span data-new>{split(step.result)!.after}</span>
              </span>
            ) : (
              <span class="fl-chip">{step.result}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>

  <ul class="fl-columns fl-columns--forge">
    {d.promises.map((p) => (
      <li>
        <p class="fl-label fl-columns__label">{p.label}</p>
        <p class="fl-columns__text">{p.text}</p>
      </li>
    ))}
  </ul>
</Chapter>

<style>
  .auto__example {
    margin: 0 0 var(--space-8);
  }
  .auto__track {
    --node-center: 34px; /* halve hoogte van een node met index: daar loopt de lijn */
    position: relative;
    padding-bottom: var(--space-8);
  }
  .auto__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .auto__step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .auto__step .fl-chip {
    margin-left: var(--space-12);
  }
  /* Beweging (automatisch.ts): vóór de node aangaat alleen de oude waarde. Zonder beweging: beide. */
  .auto__result.is-before [data-arrow],
  .auto__result.is-before [data-new] {
    display: none;
  }
  /* Eén regel per index ("Stap 01 · Automatisch"), anders verschuift het midden waar de lijn loopt. */
  .auto__step :global(.auto__node) {
    white-space: nowrap;
  }

  /* Mobiel/smal: verticale lijn links, door de nodes heen (die liggen erboven). */
  .auto__line {
    position: absolute;
    left: var(--space-6);
    top: var(--node-center);
    bottom: 0;
    width: var(--line-width);
    background: var(--forge);
  }
  .auto__flow {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(180deg, var(--ink) 0 8px, transparent 8px 80px);
    animation: auto-flow-y var(--dur-flow) linear infinite;
  }
  .auto__end {
    position: absolute;
    left: -5px;
    bottom: 0;
    width: 12px;
    height: 12px;
    background: var(--forge);
    box-shadow: var(--glow-forge);
  }
  @keyframes auto-flow-y {
    to {
      background-position: 0 80px;
    }
  }
  @keyframes auto-flow-x {
    to {
      background-position: 80px 0;
    }
  }

  /* Board: vier nodes op een rij, lijn horizontaal tot aan de rand. De nodes zijn breder dan op het board
     (de index staat op één regel), dus de tussenruimte is kleiner en de rij begint pas bij 1280px. */
  @media (min-width: 1280px) {
    .auto__track {
      padding-bottom: 0;
    }
    .auto__steps {
      flex-direction: row;
      gap: var(--space-6);
    }
    .auto__step {
      gap: var(--space-6);
    }
    .auto__step .fl-chip {
      margin-left: 0;
    }
    .auto__line {
      left: var(--space-6);
      right: 0;
      top: calc(var(--node-center) - 1px);
      bottom: auto;
      width: auto;
      height: var(--line-width);
    }
    .auto__flow {
      background: repeating-linear-gradient(90deg, var(--ink) 0 8px, transparent 8px 80px);
      animation-name: auto-flow-x;
    }
    .auto__end {
      left: auto;
      right: 0;
      top: -5px;
      bottom: auto;
    }
  }

  /* Het enige doorlopende effect op de pagina; met reduced motion staat het stil. */
  @media (prefers-reduced-motion: reduce) {
    .auto__flow {
      animation: none;
    }
  }
</style>
