---
// "Wat er daarna gebeurt": zijblok naast het formulier (Contact) en op /request-received.
import Button from '../ui/Button.astro';
import { t, type Locale } from '../../i18n';
import { site } from '../../data/site';

interface Props {
  locale?: Locale;
  /** Uniek per pagina; koppelt de kop aan het blok. */
  id?: string;
  /** Kopniveau: 3 onder een hoofdstuk (Contact), 2 direct onder de h1 (/request-received). */
  level?: 2 | 3;
  class?: string;
}

const { locale = 'nl', id = 'next-steps', level = 3, class: className } = Astro.props;
const Heading = `h${level}` as const;
const d = t(locale).contact.next;
const titleId = `${id}-title`;
---

<aside class:list={['fl-next', className]} aria-labelledby={titleId}>
  <Heading class="fl-label fl-next__title" id={titleId}>
    {d.title}
  </Heading>
  <ol class="fl-next__steps">
    {d.steps.map((step, i) => (
      <li>
        <span class="fl-label">{String(i + 1).padStart(2, '0')}</span>
        <span>{step}</span>
      </li>
    ))}
  </ol>
  <Button variant="link" href={`mailto:${site.email}`}>
    {site.email}
  </Button>
</aside>
