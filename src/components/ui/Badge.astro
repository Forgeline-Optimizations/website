---
import Icon, { type IconName } from './Icon.astro';
import type { Verdict } from '../../data/verdicts';

// Oordeel altijd als icoon + woord, nooit alleen kleur (design system → VerdictCard).
interface Props {
  verdict: Verdict;
  label: string;
}

const { verdict, label } = Astro.props;
const icons: Record<Verdict, IconName> = { go: 'arrow', wait: 'pause', no: 'no' };
---

<span class={`fl-badge fl-badge--${verdict}`}>
  <Icon name={icons[verdict]} />
  {label}
</span>
